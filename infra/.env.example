# Copy to infra/.env and adjust. Never commit infra/.env.
# Used by docker-compose.yml (ADR-0014).

# --- Image versions (pinned, never "latest") ---
KAFKA_IMAGE=apache/kafka:4.1.0
POSTGRES_IMAGE=postgres:17.6
REDIS_IMAGE=redis:8.2
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
# Build images for the "app" profile
DOTNET_VERSION=10.0
NODE_VERSION=24.15.0
NGINX_VERSION=1.29

# --- Kafka (ADR-0003) ---
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_PORT=9092
KAFKA_TOPIC_EVENTS=clickstream.events.v1
KAFKA_TOPIC_DLQ=clickstream.events.dlq
# 7 days
KAFKA_RETENTION_MS=604800000

# --- PostgreSQL (ADR-0004) ---
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
# 5433, because 5432 is often taken by a locally installed PostgreSQL
POSTGRES_PORT=5433

# --- Redis (ADR-0005) ---
REDIS_PORT=6379

# --- Application (profile "app") ---
FRONTEND_PORT=8000
API_PORT=5080

# --- Tools (profile "tools") ---
KAFKA_UI_PORT=8080
